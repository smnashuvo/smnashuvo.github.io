---
import { Icon } from 'astro-icon/components';

export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props as Props;
---

<button
	type="button"
	id="search-toggle"
	aria-haspopup="dialog"
	aria-controls="search-modal"
	aria-expanded="false"
	class={`search-trigger ${className} flex items-center justify-center`}
>
	<span class="sr-only">Open search dialog</span>
	<Icon name="tabler:search" size={22} stroke-width={1.8} aria-hidden="true" />
</button>

<div
	id="search-modal"
	class="search-modal"
	role="dialog"
	aria-modal="true"
	aria-hidden="true"
	aria-labelledby="search-modal-title"
	style="display: none;"
>
	<div class="search-modal__backdrop" data-close="search"></div>
	<div class="search-modal__panel">
		<div class="search-modal__header">
			<div class="search-modal__title">
				<p class="search-modal__eyebrow">Search</p>
				<h2 id="search-modal-title">Explore smnazmul.com</h2>
			</div>
			<div class="search-modal__actions">
				<button type="button" class="search-close" id="search-close" aria-label="Close search dialog">
					<Icon name="tabler:x" size={16} stroke-width={1.6} />
				</button>
			</div>
		</div>
		
		<div id="search" class="pagefind-ui w-full">
			<form class="pagefind-ui__form" onsubmit="event.preventDefault();">
				<input type="text" id="custom-pf-input" class="pagefind-ui__search-input" placeholder="Search posts, pages, and warlogs..." autocomplete="off">
				<button type="button" id="custom-pf-clear" class="pagefind-ui__search-clear" style="display:none;">Clear</button>
			</form>
			<div class="pagefind-ui__drawer" id="custom-pf-drawer" style="display:none;">
				<div id="custom-pf-results" class="pagefind-ui__results"></div>
			</div>
		</div>

		<p class="search-modal__footnote">Powered by Pagefind. Start typing to search.</p>
	</div>
</div>

<script is:inline>
(function() {
  const searchModal = document.getElementById('search-modal');
  const searchToggle = document.getElementById('search-toggle');
  const searchClose = document.getElementById('search-close');
  const searchBackdrop = document.querySelector('[data-close="search"]');

  if (searchModal && searchModal.parentElement !== document.body) {
    document.body.appendChild(searchModal);
  }

  const setSearchVisibility = (isOpen) => {
    if (!searchModal) return;
    searchModal.style.display = isOpen ? 'flex' : 'none';

    window.requestAnimationFrame(() => {
      searchModal.classList.toggle('is-open', isOpen);
      searchModal.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      if (searchToggle) searchToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      document.body.classList.toggle('search-open', isOpen);
    });
  };

  const focusSearchInput = () => {
    const input = document.querySelector('#search-modal .pagefind-ui__search-input');
    if (input instanceof HTMLInputElement) {
      input.focus();
      input.select();
    }
  };

  // ENGINE PRE-IGNITION: Race-Free Singleton Promise
  let pfPromise = null;
  const getPagefind = () => {
    if (!pfPromise) {
      pfPromise = import('/pagefind/pagefind.js').then(async (api) => {
        await api.init();
        return api;
      }).catch(err => {
        console.error("Pagefind Engine failed to ignite:", err);
        pfPromise = null; 
      });
    }
    return pfPromise;
  };

  const openSearch = () => {
    setSearchVisibility(true);
    getPagefind(); // Silently initialize when modal opens
    window.setTimeout(focusSearchInput, 80);
  };

  const closeSearch = () => setSearchVisibility(false);

  if (searchToggle) searchToggle.addEventListener('click', openSearch);
  if (searchClose) searchClose.addEventListener('click', closeSearch);
  if (searchBackdrop) searchBackdrop.addEventListener('click', closeSearch);

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchModal?.classList.contains('is-open')) {
      closeSearch();
    }
  });

  // RAW PAGEFIND API INTEGRATION
  const pfInput = document.getElementById('custom-pf-input');
  const pfClear = document.getElementById('custom-pf-clear');
  const pfDrawer = document.getElementById('custom-pf-drawer');
  const pfResults = document.getElementById('custom-pf-results');
  let pagefindAPI = null;

  if (pfInput) {
    let debounceTimer;
    
    pfInput.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      const query = e.target.value;
      pfClear.style.display = query ? 'block' : 'none';
      
      if (query.trim().length > 0) {
        pfDrawer.style.display = 'block';
        
        debounceTimer = setTimeout(async () => {
          const api = await getPagefind();
          if (!api) {
            pfResults.innerHTML = '<p class="pagefind-ui__message">Search engine currently unavailable.</p>';
            return;
          }
          
          const search = await api.search(query);
          pfResults.innerHTML = '';
          
          const topResults = search.results.slice(0, 15);
          if (topResults.length === 0) {
              pfResults.innerHTML = '<p class="pagefind-ui__message">No results found for your query.</p>';
              return;
          }

          for (const result of topResults) {
            const data = await result.data();

            const a = document.createElement('a');
            a.className = 'pagefind-ui__result';
            a.href = data.url;
            a.style.display = 'block';
            a.style.textDecoration = 'none';

            const title = document.createElement('p');
            title.className = 'pagefind-ui__result-title';
            title.textContent = data.meta.title;

            const excerpt = document.createElement('p');
            excerpt.className = 'pagefind-ui__result-excerpt';
            excerpt.innerHTML = data.excerpt;

            a.appendChild(title);
            a.appendChild(excerpt);
            pfResults.appendChild(a);
          }
        }, 150);
      } else {
        pfDrawer.style.display = 'none';
        pfResults.innerHTML = '';
      }
    });

    pfClear.addEventListener('click', () => {
      pfInput.value = '';
      pfClear.style.display = 'none';
      pfDrawer.style.display = 'none';
      pfResults.innerHTML = '';
      pfInput.focus();
    });
  }

  })();
</script>

<style is:inline>
.search-modal {
	position: fixed;
	inset: 0;
	width: 100vw;
	height: 100vh;
	z-index: 10005;
	display: flex;
	align-items: flex-start;
	justify-content: center;
	padding: clamp(12px, 4vw, 32px);
	opacity: 0;
	pointer-events: none;
	transition: opacity 180ms ease;
}

.search-modal.is-open {
	opacity: 1;
	pointer-events: auto !important;
}

.search-modal__backdrop {
	position: fixed;
	inset: 0;
	width: 100vw;
	height: 100vh;
	background: var(--color-paper, #fcfaf8);
	backdrop-filter: blur(14px) saturate(1.2);
	opacity: 0.94;
	z-index: 0;
}

:global(html[data-theme='dark'] .search-modal__backdrop) {
	background: color-mix(in oklab, var(--color-paper, #101012) 35%, #06060a 65%);
}

.search-modal__panel {
	position: relative;
	width: min(960px, 100%);
	margin-top: clamp(24px, 6vh, 96px);
	border: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
	background: color-mix(in oklab, var(--color-surface, #fff) 94%, transparent);
	border-radius: 24px;
	box-shadow: 0 24px 80px color-mix(in oklab, var(--color-ink, #111) 12%, transparent);
	padding: clamp(1rem, 2vw, 1.5rem);
	z-index: 1;
	display: flex;
	flex-direction: column;
	max-height: calc(100vh - 64px);
}

/* --- THE SCROLLING, HOVER & UNMUTE ARCHITECTURE --- */

#search-modal .pagefind-ui__drawer {
	overflow-y: auto !important;
	max-height: 55vh !important;
	margin-top: 1rem;
	margin-bottom: 1.5rem; /* Protected airspace for the footnote */
	padding-right: 0.5rem;
	overscroll-behavior: contain;
}

/* CYBERNETIC SCROLLBAR */
#search-modal .pagefind-ui__drawer::-webkit-scrollbar {
	width: 8px; /* Widened for usability */
}
#search-modal .pagefind-ui__drawer::-webkit-scrollbar-track {
	background: transparent;
}
#search-modal .pagefind-ui__drawer::-webkit-scrollbar-thumb {
	background: color-mix(in oklab, var(--color-ink) 20%, transparent);
	border-radius: 8px;
}
#search-modal .pagefind-ui__drawer::-webkit-scrollbar-thumb:hover {
	background: var(--color-ink); /* Absolute contrast snap */
}

#search-modal .pagefind-ui__results {
	display: grid;
	gap: 0.75rem;
}

#search-modal .pagefind-ui__result {
	padding: 1rem;
	border: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
	border-radius: 14px;
	background: transparent;
	transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1) !important;
	cursor: pointer !important;
	position: relative;
}

/* VIOLENT HOVER PHYSICS */
#search-modal .pagefind-ui__result:hover {
	border-color: color-mix(in oklab, var(--color-ink) 45%, transparent) !important;
	background: color-mix(in oklab, var(--color-ink) 8%, transparent) !important;
	transform: translateY(-4px) !important;
	box-shadow: 0 12px 32px color-mix(in oklab, var(--color-ink) 12%, transparent) !important;
}

/* TEXT UNMUTE OVERRIDE */
#search-modal .pagefind-ui__result:hover .pagefind-ui__result-excerpt,
#search-modal .pagefind-ui__result:hover .pagefind-ui__message,
#search-modal .pagefind-ui__result:hover .pagefind-ui__result-title {
	color: var(--color-ink) !important;
	opacity: 1 !important;
}

#search-modal mark {
	background: color-mix(in oklab, var(--color-ink) 12%, transparent) !important;
	color: var(--color-ink) !important;
	font-weight: 700;
	padding: 0.15rem 0.3rem;
	border-radius: 6px;
	text-decoration: none;
	box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 20%, transparent);
}

/* --- PRESERVED ORIGINAL UI --- */

.search-modal__header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	margin-bottom: 0.75rem;
}

.search-modal__title h2 {
	margin: 0.15rem 0 0;
	font-size: clamp(1.2rem, 2vw, 1.45rem);
}

.search-modal__eyebrow {
	margin: 0;
	font-size: 0.7rem;
	letter-spacing: 0.2em;
	text-transform: uppercase;
	color: var(--color-muted, #6b6b6b);
}

.search-modal__actions {
	display: inline-flex;
	align-items: center;
	gap: 0.65rem;
}

/* Purged dead ESC hint CSS */

.search-close {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 36px;
	height: 36px;
	border-radius: 12px;
	border: 1px solid color-mix(in oklab, var(--color-ink) 15%, transparent);
	background: transparent;
	color: var(--color-ink);
	cursor: pointer;
	transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
}

.search-close:hover {
	border-color: color-mix(in oklab, var(--color-ink) 35%, transparent);
	background: color-mix(in oklab, var(--color-ink) 10%, transparent);
	transform: translateY(-1px);
}

.search-modal__footnote {
	margin: 0.75rem 0 0;
	font-size: 0.82rem;
	color: var(--color-muted, #6b6b6b);
}

body.search-open {
	overflow: hidden;
}

#search-modal .pagefind-ui {
	width: 100%;
}

#search-modal .pagefind-ui__form {
	display: flex;
	align-items: center;
	gap: 0.65rem;
	padding: 0.25rem 0.75rem;
	border-radius: 12px;
	border: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
	background: color-mix(in oklab, var(--color-surface, #1a1a1a) 94%, transparent);
	box-shadow:
		inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 6%, transparent),
		0 16px 36px color-mix(in oklab, var(--color-ink) 10%, transparent);
	transition: border-color 150ms ease;
}

#search-modal .pagefind-ui__form:focus-within {
	border-color: color-mix(in oklab, var(--color-ink) 35%, transparent);
}

#search-modal .pagefind-ui__search-input {
	flex: 1;
	border: none;
	background: transparent;
	font-size: 0.95rem;
	padding: 0.25rem 0;
	color: var(--color-ink, currentColor);
	outline: none;
}

#search-modal .pagefind-ui__search-clear {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	height: 22px; 
	border-radius: 6px;
	padding: 0 0.5rem;
	font-size: 0.72rem;
	font-weight: 600;
	letter-spacing: 0.02em;
	border: 1px solid color-mix(in oklab, var(--color-ink) 25%, transparent);
	background: transparent;
	color: var(--color-ink);
	opacity: 0.95; 
	cursor: pointer;
	transition: all 150ms ease;
}

#search-modal .pagefind-ui__search-clear:hover {
	border-color: color-mix(in oklab, var(--color-ink) 45%, transparent);
	background: color-mix(in oklab, var(--color-ink) 8%, transparent); /* Subtle cybernetic glow */
	color: var(--color-ink); /* Text unmutes to pure absolute contrast */
}

#search-modal .pagefind-ui__result-title {
	margin: 0 0 0.35rem;
	font-size: 1rem;
	font-weight: 700;
}

#search-modal .pagefind-ui__result-excerpt {
	margin: 0;
	color: var(--color-ink);
	opacity: 0.55; /* Severely muted by default */
	font-size: 0.9rem;
	line-height: 1.5;
	transition: opacity 150ms ease;
}

#search-modal .pagefind-ui__message {
	text-align: left;
	font-size: 0.95rem;
	color: var(--color-muted, #6b6b6b);
}

@media (max-width: 720px) {
	.search-modal__panel {
		margin-top: clamp(16px, 5vh, 42px);
		padding: 1rem;
	}

	.search-modal__header {
		align-items: flex-start;
		flex-direction: column;
	}

	.search-modal__actions {
		align-self: flex-end;
	}

	.search-trigger {
		justify-content: center;
	}
}
</style>